+async def _until_gone(body: Iterator[bytes], lease: "_Lease") -> Any:
+    """[CST patch 2] The body, iterated in the thread pool as Starlette would; when
+    the response ends for any reason (a client that left cancels it) the lease is
+    marked ``gone`` so the slot is freed as soon as no inference is running."""
+    try:
+        async for b in iterate_in_threadpool(body):
+            yield b
+    finally:
