{
  "name": "vietnamese-subtitle-translator",
  "version": "3.0.3",
  "private": true,
  "description": "Tiện ích Chrome dịch phụ đề YouTube/Coursera sang tiếng Việt (không cần cài gói nào để chạy test)",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "coverage": "node --require ./tests/vm-coverage-preload.js --test --experimental-test-coverage --test-coverage-exclude=tests/** --test-coverage-exclude=glossary-data.js tests/*.test.js",
    "compare": "node tests/compare.js --verbose",
    "review": "node tools/review.js",
    "regress": "node tools/regress.js"
  }
}
